# Copy to .env.local for local development, and set the same keys in Vercel.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Server only. Used by seeding scripts, never imported by app code.
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed to sign in
ALLOWED_EMAIL=you@example.com

# Public URL of the app, used for magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LLM search (used from milestone 2)
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-5-5

# OneMap (used from milestone 2)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Cost guard
SEARCH_DAILY_LIMIT=30
